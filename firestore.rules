rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the authenticated user is an authorized admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'mabhishekramesh1@gmail.com' ||
         request.auth.token.email.matches('.*@silenvault[.]com$'));
    }

    // Operating Cities Collection: Public read for Zone A, Admin-only write for Zone B
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Statutory Offices Collection: Public read for Zone A, Admin-only write for Zone B
    match /offices/{officeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Custom Boundary Overrides Collection: Public read for Zone A, Admin-only write for Zone B
    match /boundaries/{boundaryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all rule: Deny all unmatched writes
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
