rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the authenticated user is an authorized admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'mabhishekramesh1@gmail.com' ||
         request.auth.token.email.matches('.*@silenvault[.]com$'));
    }

    // Operating Cities Collection: Public read, Admin-only write
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Statutory Offices Collection: Public read, Admin-only write
    match /offices/{officeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Custom Boundary Overrides Collection: Public read, Admin-only write
    match /boundaries/{boundaryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community Discrepancy & Office Reports: Public create with validation, Admin-only manage
    match /feedback_reports/{reportId} {
      allow create: if request.resource.data.cityName is string
                    && request.resource.data.cityName.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    // Dropbox Staged Payloads: Admin-only
    match /dropbox_payloads/{payloadId} {
      allow read, write: if isAdmin();
    }

    // Default catch-all rule: Deny all unmatched writes
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
